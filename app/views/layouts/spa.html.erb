<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Development only: the Vite client reads this nonce for the styles it injects. %>
    <%= tag.meta(property: "csp-nonce", nonce: content_security_policy_nonce) if content_security_policy_nonce %>
    <%= sentry_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <%# Only the SPA's own CSS: the public pages' unlayered rules would override its cascade layers. %>
    <%= vite_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
