#!/usr/bin/env ruby
# Runs a Goalner agent on this machine (spec agent-worker;
# add-runners-and-workspaces design.md, decision 5). Register the machine
# once as a runner, then start any agent by its id:
#
#   bin/goalner-worker register --url http://localhost:3000 --token glnr_runner_… --clone TEST=~/dev/goalner
#   bin/goalner-worker 6
#
# Ruby's standard library only, so that it runs without the app's bundle.
require_relative "../lib/goalner_worker/cli"

exit GoalnerWorker::Cli.new(ARGV).run
