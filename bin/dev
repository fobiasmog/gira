#!/usr/bin/env sh
# Starts Puma, the Vite dev server and, when it is installed, a LiveKit server
# for calls; stopping one stops them all.
# Open the app at http://localhost:5173.
set -e

trap 'kill 0' INT TERM EXIT
if command -v livekit-server >/dev/null 2>&1; then
  livekit-server --dev >> log/livekit.log 2>&1 &
else
  echo "livekit-server is not installed (brew install livekit), so calls will not connect."
fi
npx vite &
./bin/rails server "$@"
