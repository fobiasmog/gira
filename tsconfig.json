{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["app/frontend/**/*.ts", "app/frontend/**/*.vue"],
  // Tests run under Node (node --test) and import node:test, whose types
  // would need @types/node, which the dependency policy does not allow.
  "exclude": ["app/frontend/**/*.test.ts"]
}
